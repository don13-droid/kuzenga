DJANGO_SECRET_KEY=replace-with-a-long-random-local-development-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local Python development preserves the existing SQLite database by default.
# For a local PostgreSQL server, replace this with its URL.
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO

# Docker Compose PostgreSQL service values. Use a URL-safe local password because
# Compose constructs DATABASE_URL from these values for the web container.
POSTGRES_DB=kuzenga
POSTGRES_USER=kuzenga
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password
