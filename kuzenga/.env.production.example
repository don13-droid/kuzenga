# Documentation only. Set values in the environment store; never upload this file.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=www.elevondigitalzw.com,elevondigitalzw.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.elevondigitalzw.com
# Preserve the verified shared-domain routes: /, /login/ and /platform/login/.
# Separate portal hosts require explicit configuration and DNS verification.
PUBLIC_SITE_HOST=
PLATFORM_SITE_HOST=
CLIENT_SITE_HOST=
KUZENGA_RESOURCE_ENV=production
DEFAULT_FROM_EMAIL=inquiries@elevondigitalzw.com
DATABASE_URL=postgresql://example:example@db.example.invalid/example?sslmode=require
# Runtime uses a pooled Neon URL. Direct migration credentials are NOT app config.
LOG_LEVEL=INFO
MEDIA_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://objects.example.invalid
S3_REGION_NAME=example-region
S3_BUCKET_NAME=example-production-private
S3_ACCESS_KEY_ID=replace-with-production-access-key
S3_SECRET_ACCESS_KEY=replace-with-production-secret
S3_ADDRESSING_STYLE=auto
# Cloudflare R2 uses S3_REGION_NAME=auto and its private S3 API endpoint.
# Enable only after exact-origin bucket CORS and integration checks pass.
DIRECT_UPLOADS_ENABLED=False
# Opt in only after assessing all services on the registered domain.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Mailbox activation, Zoho region, and real delivery must be verified before release.
CONTACT_EMAIL=inquiries@elevondigitalzw.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=inquiries@elevondigitalzw.com
EMAIL_HOST_PASSWORD=replace-with-an-app-password-in-the-secret-store
