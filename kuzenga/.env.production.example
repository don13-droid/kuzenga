# Documentation only. Set values in the environment store; never upload this file.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=app.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.invalid
DATABASE_URL=postgresql://example:example@db.example.invalid/example?sslmode=require
# Runtime uses a pooled Neon URL. Direct migration credentials are NOT app config.
LOG_LEVEL=INFO
MEDIA_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://objects.example.invalid
S3_REGION_NAME=example-region
S3_BUCKET_NAME=example-preview-private
S3_ACCESS_KEY_ID=replace-with-preview-access-key
S3_SECRET_ACCESS_KEY=replace-with-preview-secret
S3_ADDRESSING_STYLE=auto
# Cloudflare R2 uses S3_REGION_NAME=auto and its private S3 API endpoint.
# Enable only after exact-origin bucket CORS and integration checks pass.
DIRECT_UPLOADS_ENABLED=False
# Opt in only after assessing all services on the registered domain.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
